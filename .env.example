# Copy to .env for local reference only (run_wanderlens.py reads env vars, not .env by default).
# Do not commit real keys. On Windows, set vars in PowerShell instead:
#   $env:OPENAI_API_KEY = "sk-..."
#   $env:GITHUB_MODELS_TOKEN = "ghp_..."

# --- Paid OpenAI ---
# OPENAI_API_KEY=sk-...

# --- Free GitHub Models (PAT: https://github.com/settings/tokens , scope: models) ---
# GITHUB_MODELS_TOKEN=ghp_...

# Run examples:
#   python run_wanderlens.py --provider openai --photos C:\path\to\album
#   python run_wanderlens.py --provider github --photos C:\path\to\album
